    {
      "id": "concept_template-based-structured-output",
      "label": "Template-Based Structured Output",
      "file_type": "rationale",
      "source_file": "app/docs/structured-output/page.tsx",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": "Kern framework design",
      "rationale": "Small models under 7B parameters struggle with JSON Schema. Nested type/object/properties syntax confuses them, producing malformed output. Fill-in-the-blank templates mirror what the model naturally wants to write, making the pattern intuitive and close-ended rather than an abstract schema specification."
    },
    {
      "id": "concept_json-repair",
      "label": "JSON Repair Pipeline",
      "file_type": "rationale",
      "source_file": "app/docs/structured-output/page.tsx",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": "Kern framework design",
      "rationale": "Even with templates, small models sometimes produce slightly broken JSON with missing braces, trailing commas, or mixed-in commentary. extract_json() handles these common failure modes automatically as a post-processing safety net."
    },
    {
      "id": "concept_kern-agent",
      "label": "Kern Agent",
      "file_type": "rationale",
      "source_file": "app/docs/agents/page.tsx",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": "Kern framework design",
      "rationale": "Core building block. Wraps a language model with instructions, tools, and structured output to turn a raw LLM into a purposeful, task-oriented assistant optimized for small models (1-7B parameters). Uses output_schema instead of Agno's response_model."
    },
    {
      "id": "concept_workflow-step-types",
      "label": "Workflow Step Types",
      "file_type": "rationale",
      "source_file": "app/docs/workflows/page.tsx",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": "Kern framework design",
      "rationale": "Composable step types (Step, Condition, Router, Loop, Parallel) enable expressing branching, routing, repetition, and concurrency within a single workflow definition. Each step delegates to an Agent."
    },
    {
      "id": "concept_kern-knowledge-base",
      "label": "Kern Knowledge Base (RAG)",
      "file_type": "rationale",
      "source_file": "app/docs/knowledge/page.tsx",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": "Kern framework design",
      "rationale": "When a knowledge base is attached to an agent, Kern automatically searches it on each run and injects relevant context into the agent's instructions. This gives small models the information they need without bloating the prompt."
    },
    {
      "id": "concept_session-storage",
      "label": "Session Storage",
      "file_type": "rationale",
      "source_file": "app/docs/storage/page.tsx",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": "Kern framework design",
      "rationale": "Persist agent sessions, conversations, and state across runs. Supports Postgres, SQLite, Redis, MongoDB backends. Conversations are automatically saved and can be resumed via session_id."
    },
    {
      "id": "concept_model-providers",
      "label": "Model Provider Abstraction",
      "file_type": "rationale",
      "source_file": "app/docs/models/page.tsx",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": "Kern framework design",
      "rationale": "All model providers follow the same interface. Swap the import and model ID and agent code stays the same. Local models are the primary use case for privacy, zero cost, and full control. Supports OpenAI-compatible endpoints, Ollama, OpenAI, Anthropic, Google, Groq, and more."
    }
  ],
